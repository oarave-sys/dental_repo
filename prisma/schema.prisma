// Dental Coding Assistant — database schema.
//
// Conventions:
//   · every tenant-scoped model carries organizationId, indexed as the LEADING column
//   · reference data (procedure codes and their rules) is GLOBAL, not tenant-scoped
//   · createdAt / updatedAt on everything
//
// Three row-level-security tiers, applied in prisma/migrations/*_row_level_security:
//   TENANT    — readable only when app.current_org_id matches organizationId
//   BOOTSTRAP — identity tables, reachable before a tenant is known (session lookup)
//   REFERENCE — procedure-code data, readable by every authenticated tenant,
//               writable only by the importer running as the owner role

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Tenancy and identity
// ---------------------------------------------------------------------------

enum OrgStatus {
  ACTIVE
  SUSPENDED
}

model Organization {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  /// Practice type. General dentistry is the only supported value today; the
  /// column exists so specialty rule packs can be added without a migration.
  practiceType String @default("GENERAL_DENTISTRY")
  timezone  String    @default("America/New_York")
  status    OrgStatus @default(ACTIVE)

  /// When false, clinical input text is discarded after the response is
  /// produced and only structured, non-clinical metadata is retained.
  /// See docs/SECURITY.md — data minimisation.
  retainQueryText Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  memberships   Membership[]
  invitations   Invitation[]
  sessions      Session[]
  codingQueries CodingQuery[]
  queryMessages CodingQueryMessage[]
  savedCases    SavedCase[]
  usageEvents   UsageEvent[]
  aiRequests    AiRequest[]
  auditEvents   AuditEvent[]
  subscription  Subscription?

  @@map("organizations")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  name         String
  passwordHash String
  status       UserStatus @default(ACTIVE)

  /// Grants access to the internal admin area at /admin. Set manually — there
  /// is deliberately no UI that can promote a user to platform administrator.
  isPlatformAdmin Boolean @default(false)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  lastSeenAt DateTime? @db.Timestamptz(6)

  memberships    Membership[]
  sessions       Session[]
  passwordResets PasswordResetToken[]
  codingQueries  CodingQuery[]
  savedCases     SavedCase[]
  usageEvents    UsageEvent[]
  auditEvents    AuditEvent[]

  @@map("users")
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

model Membership {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  userId         String @db.Uuid

  role   MemberRole       @default(MEMBER)
  status MembershipStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
  @@map("organization_members")
}

model Invitation {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  email          String
  role           MemberRole @default(MEMBER)
  /// Only the HMAC of the invitation token is stored.
  tokenHash      String     @unique
  expiresAt      DateTime   @db.Timestamptz(6)
  acceptedAt     DateTime?  @db.Timestamptz(6)
  revokedAt      DateTime?  @db.Timestamptz(6)
  createdAt      DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@map("invitations")
}

model Session {
  id             String @id @default(uuid()) @db.Uuid
  userId         String @db.Uuid
  organizationId String @db.Uuid

  /// Sessions are a random 256-bit token in an httpOnly cookie, stored only as
  /// an HMAC. A database read cannot reconstruct a usable session.
  tokenHash String @unique

  ipHash    String?
  userAgent String?

  idleExpiresAt     DateTime  @db.Timestamptz(6)
  absoluteExpiresAt DateTime  @db.Timestamptz(6)
  revokedAt         DateTime? @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Procedure-code reference data  (GLOBAL — not tenant-scoped)
//
// This is the "approved structured reference database" the coding engine
// retrieves candidates from. The language model never supplies a code.
//
// LICENSING BOUNDARY: `officialDescriptor` is the only field that may hold
// wording from a licensed CDT distribution. It ships NULL and is populated
// exclusively by scripts/import-codes.ts against a dataset the operator is
// licensed to use. Every other text field is our own independent writing.
// ---------------------------------------------------------------------------

model CodeDataset {
  id   String @id @default(uuid()) @db.Uuid
  /// Stable key, e.g. "demo-general-dentistry" or "cdt-2026-licensed".
  key  String @unique
  name String

  /// DEMO datasets carry no licensed content and are labelled as sample data
  /// throughout the UI. LICENSED datasets may carry official descriptors.
  kind        DatasetKind @default(DEMO)
  /// Free-text provenance, e.g. "ADA CDT 2026, license #12345".
  sourceNote  String?
  /// Exactly one dataset is active at a time; the engine retrieves only from it.
  isActive    Boolean     @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  codes ProcedureCode[]

  @@map("code_datasets")
}

enum DatasetKind {
  DEMO
  LICENSED
}

enum ProcedureCategory {
  DIAGNOSTIC
  PREVENTIVE
  RESTORATIVE
  ENDODONTICS
  PERIODONTICS
  PROSTHODONTICS_REMOVABLE
  PROSTHODONTICS_FIXED
  IMPLANT_SERVICES
  ORAL_SURGERY
  ADJUNCTIVE
}

enum CodeStatus {
  ACTIVE
  DEPRECATED
}

model ProcedureCode {
  id        String @id @default(uuid()) @db.Uuid
  datasetId String @db.Uuid

  /// The code number itself, e.g. "D2392". A code number is a short factual
  /// identifier, not licensed descriptive text.
  code     String
  category ProcedureCategory
  /// Our own grouping within a category, e.g. "Posterior composite".
  subcategory String?

  /// ---- Our own independently written content ----
  /// Short label shown in result cards.
  shortLabel   String
  /// Plain-English explanation of what the code covers.
  plainLanguage String
  /// When practices typically reach for this code.
  commonUse    String?
  /// What separates this code from the ones it is confused with.
  distinctions String?
  /// Information that matters when choosing this code.
  documentationConsiderations String[] @default([])
  /// Questions that help confirm this is the right selection.
  verifyQuestions             String[] @default([])

  /// ---- Licensed content boundary ----
  /// NULL in the demo dataset. Populated only from a licensed import.
  officialDescriptor       String?
  officialDescriptorSource String?

  status    CodeStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @db.Timestamptz(6)

  dataset       CodeDataset                 @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  attributes    ProcedureCodeAttribute[]
  relationsFrom ProcedureCodeRelationship[] @relation("relationFrom")
  relationsTo   ProcedureCodeRelationship[] @relation("relationTo")
  docRules      DocumentationRule[]

  @@unique([datasetId, code])
  @@index([datasetId, category])
  @@map("procedure_codes")
}

/// Structured coding attributes the deterministic ranker reads. Key/value
/// rather than columns so a licensed import can carry attributes we have not
/// modelled yet without a migration. Known keys live in src/lib/codes/attributes.ts.
model ProcedureCodeAttribute {
  id     String @id @default(uuid()) @db.Uuid
  codeId String @db.Uuid

  key       String
  /// Canonical string form. Numeric keys parse as integers; boolean keys are
  /// "true"/"false". The reader in src/lib/codes/attributes.ts enforces this.
  value     String

  code ProcedureCode @relation(fields: [codeId], references: [id], onDelete: Cascade)

  @@unique([codeId, key, value])
  @@index([key, value])
  @@map("procedure_code_attributes")
}

enum RelationshipType {
  COMMONLY_CONFUSED_WITH
  ALTERNATIVE_TO
  BUNDLED_WITH
  MUTUALLY_EXCLUSIVE_WITH
  SAME_FAMILY_DIFFERENT_COUNT
}

model ProcedureCodeRelationship {
  id           String           @id @default(uuid()) @db.Uuid
  fromCodeId   String           @db.Uuid
  toCodeId     String           @db.Uuid
  type         RelationshipType
  /// Our own note on how the two differ.
  note         String?

  fromCode ProcedureCode @relation("relationFrom", fields: [fromCodeId], references: [id], onDelete: Cascade)
  toCode   ProcedureCode @relation("relationTo", fields: [toCodeId], references: [id], onDelete: Cascade)

  @@unique([fromCodeId, toCodeId, type])
  @@index([toCodeId])
  @@map("procedure_code_relationships")
}

/// Whether a documentation element is needed to CHOOSE a code, or is
/// supporting material that may help a claim. The distinction is required by
/// the product rules: we must not present the second as if it were the first.
enum RequirementKind {
  /// Materially affects which code is correct.
  CODING_REQUIRED
  /// Commonly requested by payers as support. Never stated as universal.
  CLAIM_SUPPORT
}

enum RuleScope {
  CATEGORY
  CODE
}

/// Drives Step 4 (what is missing), Step 6 (documentation review) and the
/// documentation completeness score. Deterministic and explainable: every
/// point deducted maps to a row here.
model DocumentationRule {
  id    String    @id @default(uuid()) @db.Uuid
  scope RuleScope

  /// Set when scope = CATEGORY.
  category ProcedureCategory?
  /// Set when scope = CODE.
  codeId   String?            @db.Uuid

  /// Fact key this rule tests, e.g. "tooth_numbers". Matches the extracted
  /// fact schema in src/lib/coding/facts.ts.
  factKey String
  /// Shown in the documentation checklist, e.g. "Tooth number".
  label   String
  kind    RequirementKind
  /// Relative contribution to the completeness score. CLAIM_SUPPORT rules
  /// score too, but are reported in their own section.
  weight  Int             @default(1)
  /// The question to ask when this fact is absent. Plain, non-leading, and
  /// never phrased as a suggestion to document something that did not occur.
  promptQuestion String

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  code ProcedureCode? @relation(fields: [codeId], references: [id], onDelete: Cascade)

  @@index([scope, category])
  @@index([codeId])
  @@map("documentation_rules")
}

// ---------------------------------------------------------------------------
// Coding work  (tenant-scoped)
// ---------------------------------------------------------------------------

enum CodingTool {
  FIND_CODE
  CHECK_CODE
  DOCUMENTATION_CHECK
  CLAIM_SCRUBBER
}

enum QueryStatus {
  /// The engine asked a clarifying question and is waiting for an answer.
  NEEDS_INPUT
  COMPLETE
  FAILED
}

model CodingQuery {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  userId         String @db.Uuid

  tool   CodingTool
  status QueryStatus @default(COMPLETE)

  /// The clinical description as entered. Cleared when the organization has
  /// retainQueryText = false. Never written to application logs.
  inputText String?
  /// A short, non-clinical label for list views, derived deterministically
  /// (e.g. "Restorative · #30").
  displayLabel String?

  /// The validated CodingResult. Codes inside have already been checked to
  /// exist in the active dataset before this was written.
  result Json?

  confidence  Confidence?
  /// Denormalised for list views and usage reporting.
  primaryCode String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     CodingQueryMessage[]
  savedCases   SavedCase[]
  aiRequests   AiRequest[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, userId, createdAt(sort: Desc)])
  @@map("coding_queries")
}

enum Confidence {
  HIGH
  MEDIUM
  LOW
}

enum MessageRole {
  /// The practice's description of what was done.
  USER
  /// A clarifying question from the engine.
  ASSISTANT_QUESTION
  /// The practice's answer to a clarifying question.
  USER_ANSWER
}

model CodingQueryMessage {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  queryId        String @db.Uuid

  role    MessageRole
  content String
  /// For ASSISTANT_QUESTION: the fact key the question is trying to resolve.
  factKey String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  query        CodingQuery  @relation(fields: [queryId], references: [id], onDelete: Cascade)

  @@index([organizationId, queryId, createdAt])
  @@map("coding_query_messages")
}

model SavedCase {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  userId         String @db.Uuid
  queryId        String? @db.Uuid

  title String
  notes String?
  /// Denormalised so a saved case survives dataset changes as a record of
  /// what was recommended at the time.
  codes String[] @default([])

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  query        CodingQuery? @relation(fields: [queryId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("saved_cases")
}

// ---------------------------------------------------------------------------
// Usage, cost and billing  (tenant-scoped)
// ---------------------------------------------------------------------------

model UsageEvent {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  userId         String? @db.Uuid

  /// e.g. "query.completed", "query.clarification_asked", "case.saved".
  eventType String
  tool      CodingTool?
  /// Non-clinical metadata only: counts, durations, enum values.
  metadata  Json?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([eventType, createdAt(sort: Desc)])
  @@map("usage_events")
}

/// One row per call to the AI provider. Holds no clinical text — only counts,
/// cost and outcome, so the admin area can report spend without reading notes.
model AiRequest {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  queryId        String? @db.Uuid

  provider String
  model    String
  purpose  String

  inputTokens  Int @default(0)
  outputTokens Int @default(0)
  /// Tenth-of-a-cent precision keeps per-request cost from rounding to zero.
  costMillicents Int @default(0)
  latencyMs    Int @default(0)

  success   Boolean @default(true)
  errorCode String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  query        CodingQuery? @relation(fields: [queryId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("ai_requests")
}

/// What an audit entry describes. Kept coarse: the point is an accurate,
/// queryable record, not a second copy of the application's vocabulary.
enum AuditAction {
  CLINICAL_CONTENT_VIEWED
  CLINICAL_CONTENT_CREATED
  CLINICAL_CONTENT_DELETED
  CASE_SAVED
  CASE_DELETED
  MEMBER_INVITED
  MEMBER_ROLE_CHANGED
  MEMBER_REMOVED
  SETTINGS_CHANGED
  SIGNED_IN
  SIGNED_OUT
  ADMIN_METRICS_VIEWED
}

/// Append-only record of access to clinical content and of account changes.
///
/// Immutability is enforced by the DATABASE, not by convention: the row-level
/// security policy grants INSERT and SELECT and grants no UPDATE or DELETE, so
/// even the application role cannot rewrite history. An audit log the
/// application can edit is not an audit log.
///
/// Holds no clinical text. `subjectId` points at the row that was touched, so
/// an investigator can follow the reference; the content itself stays where it
/// already lives, under its own access control.
model AuditEvent {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  /// Null when the actor is no longer a user, so history survives deletion.
  userId         String? @db.Uuid

  action     AuditAction
  /// e.g. "CodingQuery", "SavedCase", "Membership".
  subjectType String
  subjectId   String?

  /// Hashed, never the address itself.
  ipHash    String?
  userAgent String?

  /// Non-clinical metadata only: enum values, counts, role names.
  metadata Json?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, action, createdAt(sort: Desc)])
  @@map("audit_events")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

/// Stripe is not wired up in the MVP. These columns are the seam: when Stripe
/// is connected, the webhook handler writes to exactly these fields and
/// nothing else in the application needs to change.
model Subscription {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @unique @db.Uuid

  plan   String             @default("dental_coding_assistant_monthly")
  status SubscriptionStatus @default(TRIALING)

  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  stripePriceId        String?

  /// Cents, so the displayed price never depends on a float.
  unitAmountCents Int @default(9900)
  currency        String @default("usd")

  trialEndsAt      DateTime? @db.Timestamptz(6)
  currentPeriodEnd DateTime? @db.Timestamptz(6)
  canceledAt       DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}
