// Referral OS — Phase 2 schema.
// See docs/SCHEMA.md for the full proposal, including tables scheduled for later phases.
//
// Conventions:
//   · every tenant-scoped model carries organizationId, indexed as the LEADING column
//   · createdAt / updatedAt on everything
//   · soft delete (deletedAt) only on user-editable operational records — never on
//     audit logs, status history, or the activity timeline

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Tenancy, identity, access
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  specialty String   @default("RHEUMATOLOGY")
  timezone  String   @default("America/New_York")
  status    OrgStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  settings              OrganizationSettings?
  memberships           Membership[]
  roles                 Role[]
  invitations           Invitation[]
  sessions              Session[]
  patients              Patient[]
  referrals             Referral[]
  payers                Payer[]
  referringOrgs         ReferringOrganization[]
  referringProviders    ReferringProvider[]
  documents             Document[]
  intakeBatches         IntakeBatch[]
  intakeItems           IntakeItem[]
  auditLogs             AuditLog[]
  statusHistory         ReferralStatusHistory[]
  activities            ReferralActivity[]
  contactAttempts       ContactAttempt[]
  touchMetrics          ReferralTouchMetrics[]
  matchCandidates       PatientMatchCandidate[]
  ehrLinks              EhrLink[]
  referralCategories    ReferralCategory[]
  categoryCodeMaps      ReferralCategoryCodeMap[]
  diagnosisSynonyms     DiagnosisSynonym[]
  ruleSetVersions       RuleSetVersion[]
  triageRules           TriageRule[]
  triageRuleActions     TriageRuleAction[]
  requirementDefs       RequirementDefinition[]
  payerRules            PayerRule[]
  triageEvaluations     TriageEvaluation[]
  dimensionResults      TriageDimensionResult[]
  diagnosisCandidates   DiagnosisCandidate[]
  requirementResults    ReferralRequirementResult[]

  @@map("organizations")
}

model OrganizationSettings {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @unique @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Business calendar. Required for every SLA metric — see docs/OPEN-QUESTIONS.md A-10.
  /// businessHours: { mon: [480, 1020], ... } minutes from midnight, org timezone.
  businessHours   Json
  holidayDates    String[] @default([])

  untouchedAlertBusinessDays Int @default(1)
  staleReferralDays          Int @default(7)
  missingInfoFollowupDays    Int @default(3)
  marketingFollowupDays      Int @default(14)

  /// Duplicate detection: minimum score (0-100) to surface a possible match.
  duplicateReviewThreshold Int @default(60)

  // --- Triage thresholds (Phase 3) ---
  /// What an unidentifiable diagnosis produces. YELLOW sends it to a person;
  /// UNKNOWN leaves it in a bucket someone has to remember to work.
  unknownDiagnosisBehavior UnknownDiagnosisBehavior @default(YELLOW)
  /// Below this, a diagnosis is not confident enough to route on.
  diagnosisConfidenceFloor Int @default(55)
  /// Top two candidates within this many points, disagreeing, means the system
  /// refuses to pick and asks a physician.
  contestedMargin          Int @default(12)
  /// Confidence band labels, organization-configurable.
  confidenceBands          Json?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("organization_settings")
}

/// Users are global; access to an organization is granted by a Membership.
/// A user's email and password are PII, not PHI.
model User {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String    @unique
  name                String
  passwordHash        String
  mfaSecretEncrypted  String?
  mfaEnrolledAt       DateTime? @db.Timestamptz(6)
  status              UserStatus @default(ACTIVE)
  lastLoginAt         DateTime? @db.Timestamptz(6)
  failedLoginCount    Int       @default(0)
  lockedUntil         DateTime? @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(6)

  memberships       Membership[]
  sessions          Session[]
  assignedReferrals Referral[]        @relation("ReferralAssignee")
  activities        ReferralActivity[]
  contactAttempts   ContactAttempt[]
  auditLogs         AuditLog[]
  uploadedDocuments Document[]
  intakeBatches     IntakeBatch[]

  @@map("users")
}

model Membership {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String @db.Uuid
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         MembershipStatus @default(ACTIVE)
  acceptedAt     DateTime? @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  roles MembershipRole[]

  @@unique([userId, organizationId])
  @@index([organizationId, status])
  @@map("memberships")
}

model Role {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            RoleKey
  name           String
  isSystem       Boolean @default(true)
  /// Permission strings. The role matrix in src/lib/authz is the source of truth
  /// for system roles; this column lets an org define custom roles later.
  permissions    String[]
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  memberships MembershipRole[]
  invitations Invitation[]

  @@unique([organizationId, key])
  @@map("roles")
}

model MembershipRole {
  id           String @id @default(uuid()) @db.Uuid
  membershipId String @db.Uuid
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  roleId       String @db.Uuid
  role         Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  @@unique([membershipId, roleId])
  @@map("membership_roles")
}

/// Opaque-token database sessions. The cookie carries a random 256-bit token;
/// only its SHA-256 is stored, so a database read cannot reconstruct a session.
/// Chosen over JWT so sessions are revocable server-side — see docs/DECISIONS.md.
model Session {
  id             String @id @default(uuid()) @db.Uuid
  userId         String @db.Uuid
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The organization this session is bound to. Tenancy comes from here and
  /// nowhere else — never from a request body, header or query parameter.
  organizationId String @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  tokenHash      String   @unique
  mfaSatisfied   Boolean  @default(false)
  ipHash         String?
  userAgent      String?
  idleExpiresAt  DateTime @db.Timestamptz(6)
  absoluteExpiresAt DateTime @db.Timestamptz(6)
  revokedAt      DateTime? @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  @@index([userId])
  @@index([organizationId])
  @@map("sessions")
}

model Invitation {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  roleId         String @db.Uuid
  role           Role @relation(fields: [roleId], references: [id])
  tokenHash      String @unique
  expiresAt      DateTime @db.Timestamptz(6)
  acceptedAt     DateTime? @db.Timestamptz(6)
  invitedByUserId String? @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  @@index([organizationId, email])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Pre-EHR patient staging
// ---------------------------------------------------------------------------

/// A patient exists here WITHOUT an EHR chart. That is the point of the product:
/// no chart is created for someone who never becomes a patient.
model Patient {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  firstName        String
  lastName         String
  dateOfBirth      DateTime @db.Date
  sex              String?
  phonePrimary     String?
  phoneSecondary   String?
  email            String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  postalCode       String?
  preferredLanguage String?
  notes            String?

  /// Set only by an explicit human action. The system never auto-merges patients.
  mergedIntoPatientId String? @db.Uuid
  mergedIntoPatient   Patient?  @relation("PatientMerge", fields: [mergedIntoPatientId], references: [id])
  mergedFrom          Patient[] @relation("PatientMerge")

  deletedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  referrals       Referral[]
  ehrLink         EhrLink?
  documents       Document[]
  contactAttempts ContactAttempt[]
  matchesAsSource PatientMatchCandidate[] @relation("MatchSource")
  matchesAsTarget PatientMatchCandidate[] @relation("MatchCandidate")

  @@index([organizationId, lastName, firstName, dateOfBirth])
  @@index([organizationId, dateOfBirth])
  @@index([organizationId, phonePrimary])
  @@map("patients")
}

/// Surfaced duplicate suspicions. Never acted on automatically.
model PatientMatchCandidate {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  patientId          String @db.Uuid
  patient            Patient @relation("MatchSource", fields: [patientId], references: [id], onDelete: Cascade)
  candidatePatientId String @db.Uuid
  candidatePatient   Patient @relation("MatchCandidate", fields: [candidatePatientId], references: [id], onDelete: Cascade)

  score      Int
  matchedOn  String[]
  status     MatchStatus @default(OPEN)
  reviewedByUserId String? @db.Uuid
  reviewedAt DateTime? @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  @@unique([patientId, candidatePatientId])
  @@index([organizationId, status])
  @@map("patient_match_candidates")
}

/// The EHR linkage, created only once a patient has progressed far enough to
/// deserve a chart. V1 is manual entry; the API path is designed for, not built.
model EhrLink {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patientId      String @unique @db.Uuid
  patient        Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  mrn             String
  ehrPatientId    String?
  ehrSystem       String  @default("UNSPECIFIED")
  createdInEhrAt  DateTime @db.Timestamptz(6)
  linkedByUserId  String? @db.Uuid
  linkMethod      EhrLinkMethod @default(MANUAL)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  @@unique([organizationId, mrn])
  @@map("ehr_links")
}

// ---------------------------------------------------------------------------
// Referral sources and payers
// ---------------------------------------------------------------------------

model ReferringOrganization {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name         String
  addressLine1 String?
  city         String?
  state        String?
  postalCode   String?
  phone        String?
  fax          String?
  website      String?
  npi          String?
  notes        String?
  isActive     Boolean @default(true)
  lastReferralAt DateTime? @db.Timestamptz(6)
  deletedAt    DateTime? @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  providers ReferringProvider[]
  referrals Referral[]

  @@index([organizationId, name])
  @@map("referring_organizations")
}

model ReferringProvider {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  referringOrganizationId String? @db.Uuid
  referringOrganization   ReferringOrganization? @relation(fields: [referringOrganizationId], references: [id])

  firstName  String
  lastName   String
  credential String?
  specialty  String?
  npi        String?
  phone      String?
  fax        String?
  notes      String?
  isActive   Boolean @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  referrals Referral[]

  @@index([organizationId, lastName])
  @@map("referring_providers")
}

model Payer {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name       String
  category   String?
  /// Whether the practice accepts this payer. Enforced by the Phase 3 rules
  /// engine, not here — this column is organization configuration, not policy code.
  isAccepted Boolean @default(true)
  notes      String?
  isActive   Boolean @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  referrals Referral[]

  @@unique([organizationId, name])
  @@map("payers")
}

// ---------------------------------------------------------------------------
// Referrals
// ---------------------------------------------------------------------------

model Referral {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  patientId String @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id])

  intakeChannel IntakeChannel @default(MANUAL)
  /// When the referral ARRIVED, which is not when it was uploaded. A backlog
  /// migration that conflates the two destroys every touch-time metric.
  receivedAt    DateTime @db.Timestamptz(6)

  referringOrganizationId String? @db.Uuid
  referringOrganization   ReferringOrganization? @relation(fields: [referringOrganizationId], references: [id])
  referringProviderId     String? @db.Uuid
  referringProvider       ReferringProvider? @relation(fields: [referringProviderId], references: [id])

  referralDiagnosisText String?
  referringDiagnosisCode String?

  payerId       String? @db.Uuid
  payer         Payer? @relation(fields: [payerId], references: [id])
  payerRawName  String?
  /// Member IDs are identifiers, kept out of indexes and never logged.
  memberId      String?

  assignedUserId String? @db.Uuid
  assignedUser   User? @relation("ReferralAssignee", fields: [assignedUserId], references: [id])

  status   ReferralStatus @default(NEW)
  priority ReferralPriority @default(ROUTINE)
  notes    String?

  // Workflow timestamps, set once, by the status machine.
  firstTouchedAt    DateTime? @db.Timestamptz(6)
  firstTriagedAt    DateTime? @db.Timestamptz(6)
  firstContactedAt  DateTime? @db.Timestamptz(6)
  readyToScheduleAt DateTime? @db.Timestamptz(6)
  scheduledAt       DateTime? @db.Timestamptz(6)
  closedAt          DateTime? @db.Timestamptz(6)
  closedReason      String?

  lastActivityAt DateTime @default(now()) @db.Timestamptz(6)

  deletedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  statusHistory   ReferralStatusHistory[]
  activities      ReferralActivity[]
  contactAttempts ContactAttempt[]
  documents       Document[]
  touchMetrics    ReferralTouchMetrics?
  intakeItem      IntakeItem?
  triageEvaluations TriageEvaluation[]

  /// The evaluation currently shown on the referral. Points at an immutable row.
  currentTriageEvaluationId String? @db.Uuid
  confirmedCategoryId       String? @db.Uuid
  triageConfirmedByUserId   String? @db.Uuid
  triageConfirmedAt         DateTime? @db.Timestamptz(6)

  @@index([organizationId, status, receivedAt])
  @@index([organizationId, assignedUserId, status])
  @@index([organizationId, referringOrganizationId, receivedAt])
  @@index([organizationId, receivedAt])
  @@index([organizationId, lastActivityAt])
  @@map("referrals")
}

/// Append-only. Normal users cannot edit or delete these — enforced by trigger.
model ReferralStatusHistory {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  referralId     String @db.Uuid
  referral       Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)

  fromStatus     ReferralStatus?
  toStatus       ReferralStatus
  actorType      ActorType @default(USER)
  changedByUserId String? @db.Uuid
  reason         String?
  changedAt      DateTime @default(now()) @db.Timestamptz(6)

  @@index([organizationId, referralId, changedAt])
  @@map("referral_status_history")
}

/// The operational timeline. Append-only.
/// `metadata` carries IDs and field names — never PHI values.
model ReferralActivity {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  referralId     String @db.Uuid
  referral       Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)

  type       ActivityType
  actorType  ActorType @default(USER)
  userId     String? @db.Uuid
  user       User? @relation(fields: [userId], references: [id])
  occurredAt DateTime @default(now()) @db.Timestamptz(6)
  note       String?
  subjectType String?
  subjectId   String? @db.Uuid
  metadata    Json?

  @@index([organizationId, referralId, occurredAt])
  @@map("referral_activities")
}

model ContactAttempt {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  referralId     String @db.Uuid
  referral       Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  patientId      String @db.Uuid
  patient        Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  attemptedAt   DateTime @default(now()) @db.Timestamptz(6)
  userId        String? @db.Uuid
  user          User? @relation(fields: [userId], references: [id])
  method        ContactMethod
  outcome       ContactOutcome
  note          String?
  nextAttemptAt DateTime? @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  @@index([organizationId, referralId, attemptedAt])
  @@map("contact_attempts")
}

/// Denormalized for reporting. Recomputed on every status transition so reports
/// never scan the referral table. Business-second variants respect the org calendar.
model ReferralTouchMetrics {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  referralId     String @unique @db.Uuid
  referral       Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)

  secondsToFirstTouch    Int?
  secondsToFirstTriage   Int?
  secondsToFirstContact  Int?
  secondsToReadyToSchedule Int?
  secondsToScheduled     Int?
  secondsTotalLifecycle  Int?

  businessSecondsToFirstTouch Int?
  businessSecondsToScheduled  Int?

  computedAt DateTime @default(now()) @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  @@index([organizationId])
  @@map("referral_touch_metrics")
}

// ---------------------------------------------------------------------------
// Documents and bulk intake (structure now; pipeline is Phase 4)
// ---------------------------------------------------------------------------

model Document {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Nullable on purpose: a bulk-dropped packet exists before its referral does.
  referralId String? @db.Uuid
  referral   Referral? @relation(fields: [referralId], references: [id])
  patientId  String? @db.Uuid
  patient    Patient? @relation(fields: [patientId], references: [id])

  /// Drive filenames routinely contain patient names. Treated as PHI:
  /// never logged, never in a URL, never in a job payload or audit value.
  filenameOriginal String
  contentType      String
  byteSize         Int
  sha256           String
  storageKey       String
  pageCount        Int?
  documentType     DocumentType @default(OTHER)
  documentDate     DateTime? @db.Date
  uploadedByUserId String? @db.Uuid
  uploadedBy       User? @relation(fields: [uploadedByUserId], references: [id])
  /// Distinct from Referral.receivedAt.
  uploadedAt       DateTime @default(now()) @db.Timestamptz(6)
  processingStatus ProcessingStatus @default(PENDING)
  processingErrorCode String?
  packetCoverage   Int?
  quarantinedAt    DateTime? @db.Timestamptz(6)
  quarantineReason String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  intakeItem IntakeItem?

  @@unique([organizationId, sha256])
  @@index([organizationId, referralId])
  @@map("documents")
}

model IntakeBatch {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdByUserId String? @db.Uuid
  createdBy       User? @relation(fields: [createdByUserId], references: [id])
  sourceLabel     String?
  fileCount       Int @default(0)
  bytesTotal      BigInt @default(0)
  status          IntakeBatchStatus @default(UPLOADING)
  /// Live referrals always preempt a backlog migration.
  priority        IntakePriority @default(BACKLOG)
  completedAt     DateTime? @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  items IntakeItem[]

  @@index([organizationId, status])
  @@map("intake_batches")
}

model IntakeItem {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  intakeBatchId  String @db.Uuid
  intakeBatch    IntakeBatch @relation(fields: [intakeBatchId], references: [id], onDelete: Cascade)

  filenameOriginal String
  sha256           String
  byteSize         Int
  state            IntakeItemState @default(QUEUED)
  errorCode        String?

  documentId String? @unique @db.Uuid
  document   Document? @relation(fields: [documentId], references: [id])
  /// The draft referral proposed from this packet. Nothing goes live unconfirmed.
  draftReferralId String? @unique @db.Uuid
  draftReferral   Referral? @relation(fields: [draftReferralId], references: [id])
  duplicateOfDocumentId String? @db.Uuid

  /// Each proposed field carries its value, confidence and evidence ids.
  proposedFields Json?
  reviewedByUserId String? @db.Uuid
  reviewedAt       DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  /// Makes re-dropping the same folder idempotent.
  @@unique([organizationId, sha256])
  @@index([organizationId, state])
  @@map("intake_items")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

/// Append-only, enforced by a database trigger AND by the app role's grants.
/// `metadata` records which field changed, never the value.
model AuditLog {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId     String? @db.Uuid
  user       User? @relation(fields: [userId], references: [id])
  actorType  ActorType @default(USER)
  action     AuditAction
  resourceType String
  resourceId   String?
  occurredAt DateTime @default(now()) @db.Timestamptz(6)
  ipHash     String?
  userAgent  String?
  metadata   Json?

  @@index([organizationId, occurredAt])
  @@index([organizationId, resourceType, resourceId])
  @@index([organizationId, userId, occurredAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UnknownDiagnosisBehavior {
  YELLOW
  UNKNOWN
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
}
enum UserStatus {
  ACTIVE
  DISABLED
}
enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum RoleKey {
