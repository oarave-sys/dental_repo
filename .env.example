# Application database role. Must NOT be a superuser and must NOT have BYPASSRLS —
# row-level security is a backstop and only works if the app role is subject to it.
DATABASE_URL="postgresql://referral_app:devpassword@localhost:5432/referral_os?schema=public"

# Used only by `prisma migrate` / `prisma db push`, which need DDL privileges.
DIRECT_DATABASE_URL="postgresql://referral_owner:devpassword@localhost:5432/referral_os?schema=public"

# 32+ random bytes, base64. Used to hash session tokens at rest.
SESSION_SECRET="replace-me-with-openssl-rand-base64-32"

NODE_ENV="development"
APP_URL="http://localhost:3000"
