# ---------------------------------------------------------------------------
# Dental Coding Assistant — environment
#
# The application runs with NOTHING set except SESSION_SECRET: the coding
# engine falls back to the demo dataset held in memory, and extraction runs on
# the rules engine alone. Add the rest to enable persistence and free-text
# understanding.
# ---------------------------------------------------------------------------

# REQUIRED. 32+ random bytes, base64: openssl rand -base64 32
# Used to HMAC session, invitation and reset tokens at rest.
SESSION_SECRET="replace-me-with-openssl-rand-base64-32"

# ---------------------------------------------------------------------------
# Database — enables accounts, history, saved cases, usage and the admin area.
#
# Any PostgreSQL works, including Supabase (use the connection pooler URL for
# DATABASE_URL and the direct URL for DIRECT_DATABASE_URL).
#
# The application role must NOT be a superuser and must NOT have BYPASSRLS.
# Row-level security is only a real backstop if the app is subject to it.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://dental_app:devpassword@localhost:5432/dental_coding?schema=public"

# Used only by `prisma migrate`, which needs DDL privileges.
DIRECT_DATABASE_URL="postgresql://dental_owner:devpassword@localhost:5432/dental_coding?schema=public"

# ---------------------------------------------------------------------------
# Anthropic — enables understanding of longer free-text notes.
#
# Without it, shorthand ("MOD composite #30", "exam bwx cleaning fluoride")
# still works through the deterministic rules engine. With it, prose notes are
# parsed too. The key is read server-side only and is never sent to the browser.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=""

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_URL="http://localhost:3000"
NODE_ENV="development"

# ---------------------------------------------------------------------------
# Stripe — NOT USED YET.
#
# The subscription table already holds every column a webhook would write.
# Connecting Stripe means adding a webhook route that updates those columns.
# ---------------------------------------------------------------------------
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_PRICE_ID=""

# ---------------------------------------------------------------------------
# Email — NOT USED YET.
#
# Password reset and invitation links are printed to the server console in
# development and returned to the inviter in the UI. A mail provider is needed
# before either flow works for real users.
# ---------------------------------------------------------------------------
# EMAIL_FROM=""
# RESEND_API_KEY=""
